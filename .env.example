PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=antatime
DB_PASSWORD=antatime
DB_NAME=antatime
# Zugang beschränken (beides optional, siehe README „Zugang beschränken“):
# Nur Apps mit dem Server-Schlüssel hereinlassen – Schlüsselpaar: npm run keygen
# SERVER_PRIVATE_KEY=
# Höchstzahl an Nutzern (Sync-Codes mit Daten), 0 = unbegrenzt
# MAX_VAULTS=0
# App-Updates selbst anbieten statt über GitHub-Releases (App mit UPDATE_URL gebaut)
# UPDATES_DIR=../antatime-app/dist
# Web-App im Entwicklungsmodus aus dem Flutter-Build der App ausliefern
WEB_DIR=../antatime-app/build/web
